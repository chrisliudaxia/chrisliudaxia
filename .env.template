# ============================================================================
# DramaQuickCut deployment environment template
# Current production path: Qwen video analysis + MiniMax TTS + optional GCS/S3/OSS
# ============================================================================

NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret

# Base URL used by the frontend to reach the API in production.
# Example: https://api.example.com
VITE_API_BASE_URL=

# Optional frontend public origin if the app is served from a dedicated domain.
# Example: https://app.example.com
APP_ORIGIN=

# ----------------------------------------------------------------------------
# Primary AI provider configuration
# ----------------------------------------------------------------------------
# Current supported production providers:
# - qwen    (video analysis / text generation via DashScope)
AI_VIDEO_PROVIDER=qwen

# Current supported TTS providers:
# - minimax
TTS_PROVIDER=minimax

# DashScope / Qwen (required when AI_VIDEO_PROVIDER=qwen)
DASHSCOPE_API_KEY=

# MiniMax TTS (required when TTS_PROVIDER=minimax)
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_VOICE_ID=male-qn-qingse-jingpin

# ----------------------------------------------------------------------------
# Authentication and session cookies
# ----------------------------------------------------------------------------
# If omitted in production, the server will derive a domain from the request host.
COOKIE_DOMAIN=

# ----------------------------------------------------------------------------
# Object storage (pick one backend)
# ----------------------------------------------------------------------------
# Supported values: local | gcs | s3 | oss
STORAGE_PROVIDER=local

# Local storage root (used when STORAGE_PROVIDER=local)
LOCAL_STORAGE_ROOT=./uploads

# Google Cloud Storage
GCS_BUCKET_NAME=
# Either set one of the following with JSON credentials:
# 1) Path to a JSON file
GCP_CREDENTIALS_PATH=
# 2) Inline JSON string
GCP_CREDENTIALS=

# AWS S3 / compatible object storage
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_ENDPOINT=

# Alibaba Cloud OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=

# ----------------------------------------------------------------------------
# Workflow / processing
# ----------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ----------------------------------------------------------------------------
# Development-only toggles
# ----------------------------------------------------------------------------
# Set to true only when you explicitly want local fallback stubs during development.
ALLOW_DEV_AI_MOCKS=false
